<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Cendatur</string>
	<key>CFBundleDisplayName</key>
	<string>Cendatur</string>
	<key>CFBundleIdentifier</key>
	<string>com.twarge.snapscan</string>
	<key>CFBundleExecutable</key>
	<string>Cendatur</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Taken from the build settings so CI can stamp each upload: the
	     release workflow passes CURRENT_PROJECT_VERSION from the run number,
	     which App Store Connect requires to increase every time. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Pages dragged to a new place in the page grid. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.snapscan.pages</string>
			<key>UTTypeDescription</key>
			<string>Cendatur pages</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!-- The widget's Scan button and its rows come back to the app as URLs. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.twarge.cendatur</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cendatur</string>
			</array>
		</dict>
	</array>
	<!-- The container shared with the widget extension; see WidgetShared. -->
	<key>CendaturAppGroup</key>
	<string>$(DEVELOPMENT_TEAM).com.twarge.cendatur</string>
	<!-- Shows the app's iCloud container as a "Cendatur" folder in iCloud Drive. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.twarge.cendatur</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Cendatur</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Tom Kornack. Licensed under Apache-2.0.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
